# Copied into config["envs"] at startup. Snapshots in results/ record only WHICH names are set, never values.
# Comments sit on their own lines so python-dotenv and `docker --env-file` read the same values.

# --- guardrail server ---
# clients send it as `x-api-key`; the server refuses to start if it is empty
GUARDRAIL_API_KEY=change-me
# the vLLM serving the guard model (overrides the preset's base_url)
GUARD_MODEL_BASE_URL=http://localhost:8000/v1
# key for that vLLM server
VLLM_API_KEY=EMPTY

# --- evaluation (hits the guardrail server directly) ---
GUARDRAIL_SERVER_URL=http://localhost:8080

# --- evaluation of any guardrail service through an adapter (target: http_guardrail) ---
GUARDRAIL_SERVICE_URL=http://localhost:8080
GUARDRAIL_SERVICE_API_KEY=

# --- data: needed for gated datasets / models (Llama Guard, Aegis, ...) ---
HF_TOKEN=
HF_HOME=

# --- bare-model evaluation (task: model_safety) and the LLM refusal judge ---
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_API_KEY=EMPTY
JUDGE_BASE_URL=http://localhost:8001/v1
JUDGE_API_KEY=EMPTY
