# Copied into config["envs"] at startup. Snapshots in results/ record only WHICH names are set, never values.
# --- guardrail server ---
GUARDRAIL_API_KEY=change-me            # clients send it as `x-api-key`; the server refuses to start if empty
GUARD_MODEL_BASE_URL=http://localhost:8000/v1   # vLLM serving the guard model (overrides the preset's base_url)
VLLM_API_KEY=EMPTY                     # key for that vLLM server
# --- evaluation (hits the guardrail server directly) ---
GUARDRAIL_SERVER_URL=http://localhost:8080
# --- data ---
HF_TOKEN=                              # needed for gated datasets/models (Llama Guard, Aegis, ...)
HF_HOME=
# --- bare-model evaluation (task: model_safety) and LLM refusal judge ---
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_API_KEY=EMPTY
JUDGE_BASE_URL=http://localhost:8001/v1
JUDGE_API_KEY=EMPTY
