# Copied into config["envs"] at startup. Secrets are REDACTED when config.yaml is dumped into results/.
# --- guardrail server ---
GUARDRAIL_API_KEY=change-me            # LiteLLM sends this as `x-api-key` (litellm_params.api_key)
VLLM_API_KEY=EMPTY                     # key for the vLLM OpenAI-compatible server hosting the guard model
# --- evaluation targets ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=sk-1234
GUARDRAIL_SERVER_URL=http://localhost:8080
# --- data ---
HF_TOKEN=                              # needed for gated datasets/models (Llama Guard, Aegis, ...)
HF_HOME=
# --- LiteLLM admin API (src.litellm_admin) ---
LITELLM_ADMIN_KEY=                     # PROXY_ADMIN key; keep separate from LITELLM_API_KEY
OJT_GUARDRAIL_API_BASE=http://guardrail-svc:8080
OJT_GUARDRAIL_CANDIDATE_API_BASE=http://guardrail-svc-candidate:8080
OJT_GUARDRAIL_API_KEY=change-me        # same value as GUARDRAIL_API_KEY on the guardrail service
# --- bare-model evaluation (task: model_safety) ---
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_API_KEY=EMPTY
